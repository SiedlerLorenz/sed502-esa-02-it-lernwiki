# Vorlage für die Umgebungsvariablen des IT-Lernwikis
# 1. Diese Datei nach .env kopieren
# 2. Eigenen Schlüssel eintragen (kostenlos unter https://aistudio.google.com/apikey)
# Kein VITE_-Präfix: Der Schlüssel bleibt im Vite-Server und landet nicht im Browser-Bundle.
GEMINI_API_KEY=

# Optional: anderes Gemini-Modell verwenden (Standard: gemini-3.5-flash)
GEMINI_MODELL=
